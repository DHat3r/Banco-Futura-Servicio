# Configuración de docker compose. Copia este archivo a .env (está en .gitignore)
# y ajusta los valores; compose lo lee solo al hacer `docker compose up`.

# true = instala y activa el modelo de sentimiento (BETO). Imagen pesada y primer arranque lento.
INSTALL_SENTIMENT=false

# Puerto donde se publica la API (Swagger en http://localhost:<API_PORT>/docs).
# Cámbialo si el 8000 está ocupado, por ejemplo a 18000.
API_PORT=8000
